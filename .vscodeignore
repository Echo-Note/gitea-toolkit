# 源码、构建脚本与开发配置不进包
src/**
scripts/**
out/**
node_modules/**
.vscode/**
.github/**
.codebuddy/**
.gitignore
eslint.config.mjs
tsconfig.json
esbuild.js
**/*.map

# 独立发布的 npm 包整体不进扩展包：
# 它内含一份与 dist/mcpServer.js 内容相同的 bundle，打进来等于让每个 .vsix 白白多背 ~400KB。
# 两者由同一次 esbuild 构建产出，扩展运行时只用自己的 dist/mcpServer.js。
packages/**

# 市场图标的可编辑源文件：运行时只用到 media/icon.png，源文件留在仓库里便于改版
media/icon.svg

# 打包产物必须保留
!dist/**
!dist/mcpServer.js
!dist/extension.js
!README.md
!CHANGELOG.md
!LICENSE
!package.json

# 媒体资源逐个白名单，而不是整目录放行：
#   gitea.svg —— 活动栏图标（必须打包，VS Code 主题图标只能是 SVG）
#   icon.png  —— 市场展示图标（必须打包，且市场禁 SVG）
# media/icon.svg 是可编辑源文件，运行时用不到，故不列入
!media/gitea.svg
!media/icon.png
